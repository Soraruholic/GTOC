  "units": [
    {
      "id": "plant-c",
      "name": "C · 产线控制器",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "总览全批状态，自动运行或分步学习。",
      "inputs": "F 储存的标准物料，背包催化芯和煤。",
      "outputs": "进料、中间料、成品数量，热量、催化状态、干燥余量。",
      "operation": "右键 → 组分库存；安装催化芯、加入一块煤；自动运行本批 / 执行下一阶段；先分配釜底才可准备下一批。",
      "analysis": "每块煤兑换 200000 J 教学热量；没有 GT EU 接口。准备下一批不会自动启动。"
    },
    {
      "id": "plant-f",
      "name": "F · 计量进料口",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "把标准流体按密度约定换算为 mol。",
      "inputs": "无 NBT 的 aceticacid、bioethanol、water；任意面 Forge 接口；共享 128 mol 容量。",
      "outputs": "四组分 mol 与可映射组分的等效 mB；余料保留。",
      "operation": "右键只读库存；Ender IO 储罐底面 Push 直连或 GT 管道供料。无桶/容器槽入口。",
      "analysis": "计算期间暂停进料。等效 mB 是桥接读数，不是反应釜体积或真实混合体积。"
    },
    {
      "id": "plant-r",
      "name": "R · 酸催化反应釜",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "观察可逆酯化中原料减少、酯与副产水增加。",
      "inputs": "每批新鲜乙酸和乙醇各 1 mol，以及完整的回流混合物。",
      "outputs": "最近反应的入口/出口、当前中间料；61 点时间—组成记录。",
      "operation": "右键默认打开反应曲线；mol / x 切换，悬停读数；就绪时可安装催化芯、执行反应。",
      "analysis": "600 s 为模型反应时间；每 10 s 保存一点。纵轴 mol 或摩尔分数，不是 mol/L。后续分离改变当前中间料，但不改反应历史。"
    },
    {
      "id": "plant-d",
      "name": "D · 蒸馏与冷凝",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "追踪蒸馏出口、釜底与供热。",
      "inputs": "R 完成后的完整四组分混合物、可用教学热量。",
      "outputs": "最近蒸馏的入口、冷凝馏出物和釜底。",
      "operation": "右键查看库存；反应完成后执行蒸馏；缺热时加入一块煤。",
      "analysis": "单级间歇蒸馏，尚无多级精馏塔。工序记录列出热量与相态。"
    },
    {
      "id": "plant-w",
      "name": "W · 水洗与分相",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "比较提纯和酯流失的代价。",
      "inputs": "冷凝馏出物与 F 中的洗水；相平衡温度 298.15 K。",
      "outputs": "最近一洗的混合入口、有机相出口、水相旁路；全批洗涤计数。",
      "operation": "右键 → 执行下一阶段，每次一洗；已完成洗涤且总次数小于 16 时可追加一次水洗，再继续运行。",
      "analysis": "水相同时带走杂质与部分酯。无分层时保留完整混合物，不假装总能形成两相。"
    },
    {
      "id": "plant-a",
      "name": "A · 有限容量干燥",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "检查容量不足如何影响成品质检。",
      "inputs": "水洗后的有机相；每枚干燥芯增加 0.1 mol 除水容量。",
      "outputs": "最近入口、干燥出口、吸附水；剩余除水容量。",
      "operation": "右键安装干燥芯；水洗结束后执行干燥。OFF_SPEC 时湿料不丢失，补芯或追加水洗再试。",
      "analysis": "有限容量且理想水选择性；没有吸附等温线。默认首批耗约 0.06134 mol 容量，后续批次要检查余量。"
    },
    {
      "id": "plant-p",
      "name": "P · 成品收集器",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "确认产品实际组成并取出。",
      "inputs": "通过 ≥95 wt% 质量门的成品混合物。",
      "outputs": "四组分 mol、质量分数与空库存提示；取出一个含总量的定量样品。",
      "operation": "右键 → 取出全部成品；主背包留一个完全空格；Esc 关闭后悬停检查样品。",
      "analysis": "不消耗空玻璃瓶；没有自动塞满背包。一次取走全部库存，不能重复领取。样品尚不能回注或兑换纯 GT 流体。"
    },
    {
      "id": "plant-t",
      "name": "T · 釜底与废液",
      "status": "0.3.1：已实现右键面板；客户端视觉待验收",
      "purpose": "保留并分配余料，开始下一批。",
      "inputs": "本批釜底、洗涤废液。",
      "outputs": "待分配釜底、下批回流、累计废液，各保留四组分。",
      "operation": "右键选择全部排废 / 回收 50% / 全部回收；余料分配后到 C 准备下一批；可取出全部废液为一个样品。",
      "analysis": "回流带回酸、醇、水、酯整股混合物。废液取出是物料转移，非删除。"
    }
