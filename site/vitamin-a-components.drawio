&#10;单写入器落盘 → 确认&#10;CommitReceipt / revision" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0efe6;strokeColor=#367760;fontColor=#243f36;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="580" width="310" height="120" as="geometry" /></mxCell><mxCell id="delta" value="CandidateDelta&#10;候选物料与能量变化&#10;未确认前不改变世界库存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0efe6;strokeColor=#367760;fontColor=#243f36;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="815" y="580" width="310" height="120" as="geometry" /></mxCell><mxCell id="trace" value="观测 / Wiki / 报告&#10;真实积分轨迹、单位、来源&#10;设计目录与游戏目录区分" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffdf7;strokeColor=#85988d;fontColor=#243f36;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="580" width="245" height="120" as="geometry" /></mxCell><mxCell id="edge-8" value="" source="solver" target="delta" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#59796a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#fffdf7;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="" source="delta" target="commit" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#59796a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#fffdf7;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="" source="commit" target="ledger" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#59796a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#fffdf7;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-11" value="计算记录" source="delta" target="trace" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#59796a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#fffdf7;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bridge" value="GT 外部边界缓冲 / 不确定隔离&#10;外部 drain/fill 与 OC 存档不共享事务日志" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1d9;strokeColor=#a56d27;fontColor=#243f36;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="805" width="695" height="90" as="geometry" /></mxCell><mxCell id="recovery" value="重启恢复与迁移&#10;已提交 / 未提交 / 不确定；禁止盲目补发&#10;旧版快照保留，无法映射则只读隔离" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5eef3;strokeColor=#487284;fontColor=#243f36;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="815" y="805" width="600" height="90" as="geometry" /></mxCell><mxCell id="edge-12" value="" source="ledger" target="bridge" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#59796a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#fffdf7;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="" source="commit" target="recovery" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#59796a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#fffdf7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="end" value="OC↔OC 可以使用同一账本；GT↔OC 无外部幂等 token 时，不能声称跨独立存档严格原子。图为软件/物料合同，不是工程 P&amp;ID。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#264b40;" vertex="1" parent="1"><mxGeometry x="35" y="937" width="1390" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>